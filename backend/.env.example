DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
PORT=4000
CORS_ORIGIN="http://localhost:5173"
OSRM_BASE_URL="https://router.project-osrm.org"
# Crowd/sensory thresholds are user-selectable per request (low/medium/high) - see
# src/config/sensitivity.ts - rather than a single fixed env-configured value.
# DATABASE_URL is the team's shared Neon Postgres instance (ask the DB owner) - this
# backend only reads from it, it does not own migrations or ingestion.
